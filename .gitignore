# Environment files and secrets; keep reviewed, credential-free examples.
.env
.env.*
!.env.example
!.env.*.example
.secrets/
secrets/
credentials.json
credentials.yaml
credentials.yml
credentials.toml
credentials-*.json
*.credentials.json
service-account*.json
api_keys.json
api-keys.json
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc
.pypirc

# Python environments, bytecode, packages and tool caches.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# React / Node build output and caches; lockfiles remain tracked.
node_modules/
dist/
build/
.vite/
.cache/
.turbo/
coverage/
*.tsbuildinfo
playwright-report/
test-results/

# Runtime storage (root paths); never use these for source or safe fixtures.
/data/
/runtime/
/storage/
/uploads/
/exports/
/artifacts/
/backups/
/pgdata/
/postgres-data/
/docker-volumes/
/volumes/
*.parquet
*.arrow
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
*.dump
*.backup
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zip

# Only reviewed synthetic fixtures may be committed, including binary formats.
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.arrow
!tests/fixtures/**/*.duckdb
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!tests/fixtures/**/*.db
!tests/fixtures/**/*.dump
!tests/fixtures/**/*.backup
!fixtures/**/*.parquet
!fixtures/**/*.arrow
!fixtures/**/*.duckdb
!fixtures/**/*.sqlite
!fixtures/**/*.sqlite3
!fixtures/**/*.db
!fixtures/**/*.dump
!fixtures/**/*.backup

# Private material must be kept in explicitly excluded locations.
/internal/
/private/
/docs/internal/
/docs/private/

# Logs, temporary files, editor and OS artifacts.
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
/tmp/
/temp/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
