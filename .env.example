# Copy to .env or run tools/start.ps1 to create random local credentials.
POSTGRES_PASSWORD=replace-with-random-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN=
LOCAL_DEMO_ACCESS=true
# Chỉ bật sau nghiệm thu. Mỗi lần xóa cần owner duyệt tên và manifest mới nhất.
PURGE_LOCAL_ENABLED=false
QWEN_BASE_URL=https://provider.example.invalid/v1
QWEN_MODEL=knowledge
QWEN_ENABLED=true
MAPPING_AI_PROVIDER=GEMINI
AI_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ollama trên host Windows. Để trống cho đến khi nghiệm thu model local.
OLLAMA_URL=
OLLAMA_CHOICE=QWEN_27B
ASSISTANT_DEFAULT_MODEL=GEMINI
OLLAMA_CONTEXT=8192
OLLAMA_TIMEOUT_SECONDS=90
ALLOW_EXTERNAL_AI=false
# Local authorized testing: request budgets accept unlimited only with LOCAL_DEMO_ACCESS=true.
# Workspace cloud permission is still required; provider quotas and usage auditing remain.
EXTERNAL_AI_REQUEST_BUDGET=0
PLANNER_REQUEST_BUDGET=2
ASSISTANT_CLOUD_ENABLED=false
ASSISTANT_REQUEST_BUDGET=0
AGENT_CLOUD_ENABLED=false
AGENT_REQUEST_BUDGET=0
LLAMA_CLOUD_API_KEY=
ALLOW_CLOUD_PARSING=false
# Verified local installs may opt in to unlimited internal parser ceilings. File SHA
# authorization, upstream credits, per-document limits, and delivery fencing still apply.
CLOUD_PARSER_REQUEST_BUDGET=0
CLOUD_PARSER_CREDIT_BUDGET=0
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_FILES=10
MAX_ROWS=100000
MAX_COLUMNS=200
