        ["fee_amount", "Fee amount", "Tiền phí", "Processing fee", "decimal", "fee"],
        ["payment_date", "Payment date", "Ngày trả tiền", "Actual payment date", "date", "date"],
        ["currency", "Currency", "Tiền tệ", "Currency code", "string", "currency"]
      ]
    },
