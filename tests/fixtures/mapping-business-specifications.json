{
  "revision": "business-mapping-1",
  "purpose": "Independent synthetic business definitions, fixed before candidate evaluation. No Matcher, LLM or prediction provides a label. All results remain proposals.",
  "protocol": {
    "splits": ["development", "validation", "holdout"],
    "seed": 671109,
    "rows": 48,
    "sample_limit": 48,
    "top_k": [1, 3, 5],
    "rapidfuzz_cutoff": 65,
    "valentine": "Coma(use_instances=True), max_n=5, default delta/threshold",
    "hybrid": "existing exact aliases first, then equally weighted RapidFuzz and Coma candidates; no approval",
    "ambiguous": "Gold null requires abstention. Value overlap alone does not establish a business meaning. All monetary columns deliberately share a distribution. All identifier columns deliberately share values.",
    "limits": "Column matching only. Grain/timezone/coverage correctness and false auto-approval must be evaluated separately through the approval and reuse gates. This synthetic benchmark is not a production accuracy claim."
  },
  "domains": [
    {
