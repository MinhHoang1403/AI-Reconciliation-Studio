      "columns": [
        ["order_id", "Order ID", "Mã đơn hàng", "Order reference", "string", "key"],
        ["payment_id", "Payment ID", "Mã thanh toán", "Payment reference", "string", "key"],
        ["customer_id", "Customer ID", "Mã khách hàng", "Customer reference", "string", "key"],
